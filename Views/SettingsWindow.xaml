<Window x:Class="TimeInset.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:TimeInset.Views"
        xmlns:l="clr-namespace:TimeInset.Core.Localization;assembly=TimeInset.Core"
        Width="600" Height="620" MinWidth="520" MinHeight="440"
        FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <!-- 設定画面は保存する設定だけを扱う。タイマー操作・位置リセット・終了は右クリックメニューとトレイに置く。
         表示タブの編集は実際の表示ウィンドウへすぐ反映し（未保存）、［キャンセル］・×で元に戻す。 -->
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,16,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="52" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4,16,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="BorderBrush" Value="DimGray" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="SuspendNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#8A4B00" Margin="0,0,0,6"
                       Text="{x:Static l:Strings.HotkeysSuspended}" />
            <TextBlock x:Name="NoticeText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#1565C0" Margin="0,0,0,6" />
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#C62828" Margin="0,0,0,6" />
            <!-- ボタンの並びはPlainClipと同じ（OK・キャンセル・適用）。適用は未適用の変更があるときだけ押せる。 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="{x:Static l:Strings.OK}" MinWidth="80" Padding="8,3" IsDefault="True" Click="OnOk" />
                <!-- Show()（モードレス）で開くため IsCancel だけでは閉じない。Click で閉じる（Esc も同じ）。 -->
                <Button Content="{x:Static l:Strings.Cancel}" MinWidth="80" Padding="8,3" Margin="8,0,0,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="ApplyButton" Content="{x:Static l:Strings.Apply}" MinWidth="80" Padding="8,3" Margin="8,0,0,0" IsEnabled="False" Click="OnApply" />
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="Tabs">
            <!-- 表示 -->
            <TabItem Header="{x:Static l:Strings.Display}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 項目のON/OFFと順番（縦並び・横一列で共通）。行はコードで作る。 -->
                            <TextBlock Text="{x:Static l:Strings.ShownItems}" Style="{StaticResource Label}" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" x:Name="ItemsPanel" Margin="0,2,0,4" />

                            <TextBlock Grid.Row="1" Text="{x:Static l:Strings.Layout}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="LayoutCombo" HorizontalAlignment="Left" MinWidth="160"
                                      AutomationProperties.Name="{x:Static l:Strings.Layout}" />

                            <TextBlock Grid.Row="2" Text="{x:Static l:Strings.FontSize}" Style="{StaticResource Label}" />
                            <Slider Grid.Row="2" Grid.Column="1" x:Name="FontSizeSlider" Minimum="12" Maximum="120" TickFrequency="1"
                                    SmallChange="1" LargeChange="4" AutomationProperties.Name="{x:Static l:Strings.FontSize}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="FontSizeValue" Style="{StaticResource Value}" />

                            <!-- 文字色は決め打ちの候補から選ぶ。縁取りの色は文字色ごとに決まる（白・黄・緑は黒、黒・青は白）。 -->
                            <TextBlock Grid.Row="3" Text="{x:Static l:Strings.Foreground}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ForegroundCombo" HorizontalAlignment="Left" MinWidth="200"
                                      AutomationProperties.Name="{x:Static l:Strings.Foreground}" />

                            <TextBlock Grid.Row="4" Text="{x:Static l:Strings.Background}" Style="{StaticResource Label}" />
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="BackgroundCombo" HorizontalAlignment="Left" MinWidth="200"
                                      AutomationProperties.Name="{x:Static l:Strings.Background}" />

                            <TextBlock Grid.Row="5" Text="{x:Static l:Strings.Opacity}" Style="{StaticResource Label}" />
                            <Slider Grid.Row="5" Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="100" TickFrequency="5"
                                    SmallChange="5" LargeChange="10" AutomationProperties.Name="{x:Static l:Strings.Opacity}" />
                            <TextBlock Grid.Row="5" Grid.Column="2" x:Name="OpacityValue" Style="{StaticResource Value}" />
                        </Grid>
                        <WrapPanel Margin="0,8,0,0">
                            <CheckBox x:Name="OutlineCheck" Content="{x:Static l:Strings.Outline}" />
                            <CheckBox x:Name="IconsCheck" Content="{x:Static l:Strings.Icons}" />
                            <CheckBox x:Name="TopmostCheck" Content="{x:Static l:Strings.Topmost}" />                        </WrapPanel>
                        <Button Content="{x:Static l:Strings.ResetDefaults}" HorizontalAlignment="Left" Padding="10,3" Margin="0,14,0,0" Click="OnResetDefaults" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 時計 -->
            <TabItem Header="{x:Static l:Strings.Clock}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="{x:Static l:Strings.ClockSource}" Style="{StaticResource Heading}" />
                        <RadioButton x:Name="CurrentRadio" GroupName="Mode" Content="{x:Static l:Strings.CurrentTime}" />
                        <RadioButton x:Name="SpecifiedRadio" GroupName="Mode" Content="{x:Static l:Strings.SpecifiedTime}" />
                        <!-- 日付はカレンダーから選ぶ（直接入力も可）。時刻は時・分・秒を選ぶ。 -->
                        <StackPanel x:Name="SpecifiedPanel" Orientation="Horizontal" Margin="22,4,0,0">
                            <TextBlock Text="{x:Static l:Strings.SpecifiedInput}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <DatePicker x:Name="SpecifiedDatePicker" Width="140" SelectedDateFormat="Short" VerticalContentAlignment="Center"
                                        DisplayDateStart="2000-01-01" DisplayDateEnd="2099-12-31" AutomationProperties.Name="{x:Static l:Strings.SpecifiedInput}" />
                            <ComboBox x:Name="HourCombo" Width="56" Margin="12,0,0,0" AutomationProperties.Name="時" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                            <ComboBox x:Name="MinuteCombo" Width="56" AutomationProperties.Name="分" />
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="4,0" />
                            <ComboBox x:Name="SecondCombo" Width="56" AutomationProperties.Name="秒" />
                        </StackPanel>
                        <TextBlock Text="{x:Static l:Strings.ClockHelp}" Style="{StaticResource Note}" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 全般 -->
            <TabItem Header="{x:Static l:Strings.TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="{x:Static l:Strings.Hotkeys}" Style="{StaticResource Heading}" />
                        <!-- AreaShot と同じく、入力欄の下に状態を出す（登録済み=緑、使えない=赤、未適用=灰）。
                             新しいキーは入力した時点で一時登録を試し、使えるかどうかをすぐ示す。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="170" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static l:Strings.ToggleTimer}" Style="{StaticResource Label}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <v:ShortcutBox x:Name="ToggleTimerBox" Width="200" Height="26" AutomationProperties.Name="{x:Static l:Strings.ToggleTimer}" />
                                <Button Content="{x:Static l:Strings.Clear}" Margin="8,0,0,0" Padding="8,0" Height="26" Focusable="False" Click="OnClearHotkey" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ToggleTimerStatus" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{x:Static l:Strings.HotkeyHelp}" Style="{StaticResource Note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- バージョン情報 -->
            <TabItem Header="{x:Static l:Strings.TabAbout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12">
                        <TextBlock Text="TimeInset" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" Foreground="#555" />
                        <TextBlock Text="© ja1bus" Margin="0,2,0,0" Foreground="#555" />
                        <!-- Webサイト・取扱説明書・プライバシーポリシーは Web だけに置く（ページ公開前でも記載）。 -->
                        <TextBlock Margin="0,16,0,0">
                            <Hyperlink Click="OnOpenWebsite"><Run Text="{x:Static l:Strings.AboutWebsiteLink}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink Click="OnOpenManual"><Run Text="{x:Static l:Strings.AboutManualLink}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink Click="OnOpenPrivacy"><Run Text="{x:Static l:Strings.AboutPrivacyLink}" /></Hyperlink>
                        </TextBlock>
                        <!-- ライセンスの全文は同梱の LICENSE をこの画面から表示し、Web だけに頼らない。 -->
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink Click="OnShowLicense" ToolTip="{x:Static l:Strings.AboutLicenseTip}"><Run Text="{x:Static l:Strings.AboutLicenseLink}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink Click="OnOpenSource"><Run Text="{x:Static l:Strings.AboutSourceLink}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink Click="OnShowNotices" ToolTip="{x:Static l:Strings.AboutNoticesTip}"><Run Text="{x:Static l:Strings.AboutNoticesLink}" /></Hyperlink>
                        </TextBlock>
                        <TextBlock Text="{x:Static l:Strings.SettingsPath}" Style="{StaticResource Heading}" Margin="0,20,0,4" />
                        <TextBox x:Name="SettingsPathText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                        <TextBlock Text="{x:Static l:Strings.Privacy}" Style="{StaticResource Note}" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- 試験用: 本物の AppHost を1回の起動で1場面だけ動かす（Application は1プロセスに1つで、終了すると作り直せないため）。
       Tests から ExitHarnessTests が起動する。配布物には含めない。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest>../../app.manifest</ApplicationManifest>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Windows.Forms"/><Using Remove="System.Drawing"/>
    <Using Include="System.IO"/>
    <ProjectReference Include="../../Core/TimeInset.Core.csproj"/>
    <ProjectReference Include="../../TimeInset.csproj"/>
  </ItemGroup>
</Project>
